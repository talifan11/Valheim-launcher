// ============================================================
// Права доступа (capabilities) для фронтенда — модель безопасности Tauri v2.
// Разрешаем ровно то, что нужно UI: управление своим окном (кастомная
// шапка!) и диалог выбора папки в настройках.
// ============================================================
{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Базовые права лаунчера: окно + диалоги",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "dialog:allow-open"
  ]
}
